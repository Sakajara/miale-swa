husisha { kifuatilia.swa }
husisha { kumbukumbu.swa }
husisha { mfuatano.swa }
husisha { faili.swa }

// miale.swa -- Kifuatilia-miale (raytracer) kwa Swa safi: programu ya
// mstari-wa-amri. Kiini cha uchoraji kiko kwenye kifuatilia.swa.
//
// Matumizi:
//   miale                              -> 400x300, sampuli 2x2, miale.ppm
//   miale <upana> <urefu>              -> ukubwa mwingine
//   miale <upana> <urefu> <sampuli>    -> antialiasing SAMPULI x SAMPULI (1..8)
//   miale <upana> <urefu> <sampuli> <faili.ppm>
//
// Upana na urefu: 1..4096. Msimbo wa kutoka: 0 = sawa, 1 = kosa la
// kuandika faili au kumbukumbu, 2 = hoja zisizo sahihi.

n32 UPANA_CHAGUO_MSINGI = 400;
n32 UREFU_CHAGUO_MSINGI = 300;
n32 SAMPULI_CHAGUO_MSINGI = 2;
n32 KIKOMO_KIPIMO = 4096;
n32 KIKOMO_SAMPULI = 8;

// Soma nambari kamili chanya kutoka `s` (tarakimu 1..9 tu). Inarudisha -1
// kama `s` si nambari kamili.
n32 soma_hoja(n8* s) {
    n32 n = urefu_wa_mfuatano(s);
    kama (n < 1 || n > 9) { rudisha 0 - 1; }
    n32 i = 0;
    wakati (i < n) {
        n32 c = s[i] & 255;
        kama (c < 48 || c > 57) { rudisha 0 - 1; }
        i = i + 1;
    }
    rudisha mfuatano_hadi_n32(s);
}

w0 onyesha_matumizi() {
    andika_stderr("matumizi: miale [upana urefu [sampuli [faili.ppm]]]\n", 0, 0, 0, 0, 0, 0);
    andika_stderr("  upana, urefu: 1..%d   sampuli: 1..%d\n", KIKOMO_KIPIMO, KIKOMO_SAMPULI, 0, 0, 0, 0);
}

n32 main(n32 argc, n8** argv) {
    n32 upana = UPANA_CHAGUO_MSINGI;
    n32 urefu = UREFU_CHAGUO_MSINGI;
    n32 sampuli = SAMPULI_CHAGUO_MSINGI;
    n8* towe = "miale.ppm";

    kama (argc == 2 || argc > 5) { onyesha_matumizi(); rudisha 2; }
    kama (argc >= 3) {
        upana = soma_hoja(argv[1]);
        urefu = soma_hoja(argv[2]);
        kama (upana < 1 || upana > KIKOMO_KIPIMO || urefu < 1 || urefu > KIKOMO_KIPIMO) {
            andika_stderr("kosa: upana na urefu lazima viwe nambari kati ya 1 na %d\n", KIKOMO_KIPIMO, 0, 0, 0, 0, 0);
            onyesha_matumizi();
            rudisha 2;
        }
    }
    kama (argc >= 4) {
        sampuli = soma_hoja(argv[3]);
        kama (sampuli < 1 || sampuli > KIKOMO_SAMPULI) {
            andika_stderr("kosa: sampuli lazima iwe kati ya 1 na %d\n", KIKOMO_SAMPULI, 0, 0, 0, 0, 0);
            onyesha_matumizi();
            rudisha 2;
        }
    }
    kama (argc >= 5) { towe = argv[4]; }

    n8* picha = tenga(chora_ukubwa(upana, urefu));
    kama (picha == 0) {
        andika_stderr("kosa: kumbukumbu imeisha (picha %d x %d)\n", upana, urefu, 0, 0, 0, 0);
        rudisha 1;
    }
    n64 urefu_wa_faili = chora_picha(picha, upana, urefu, sampuli);
    kama (faili_andika_yote(towe, picha, urefu_wa_faili) != 0) {
        andika_stderr("kosa: imeshindwa kuandika %s\n", towe, 0, 0, 0, 0, 0);
        rudisha 1;
    }
    andika("%s imeandikwa (%d x %d, sampuli %d)\n", towe, upana, urefu, sampuli, 0, 0);
    rudisha 0;
}
