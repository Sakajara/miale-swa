husisha { mandhari.swa }
husisha { kumbukumbu.swa }
husisha { mfuatano.swa }
husisha { faili.swa }

// miale.swa -- Kifuatilia-miale (raytracer) kwa Swa safi.
// Huchora mandhari (angalia mandhari.swa: duara tatu kwenye sakafu ya
// ubao wa chesi, taa moja, vivuli) kwa antialiasing ya SAMPULI x SAMPULI,
// na kuandika picha kwenye miale.ppm.

N32 UPANA = 400;
N32 UREFU = 300;
N32 SAMPULI = 2;      // sampuli SAMPULI x SAMPULI kwa kila pikseli (antialiasing)

N32 main() {
    jenga_ulimwengu();
    N64 uwezo = (UPANA * UREFU * 3) + 64;
    N8* picha = tenga(uwezo);
    N64 kichwa = mfuatano_umbiza(picha, 64, "P6\n%d %d\n255\n", UPANA, UREFU, 0, 0, 0, 0);

    Vekta jicho = vekta_mpya(0.0, 0.0, 1.0);
    D64 upana_d = UPANA;
    D64 urefu_d = UREFU;
    D64 uwiano = upana_d / urefu_d;
    D64 kipimo = 0.75;   // tan(nusu ya pembe ya kuona)

    N64 wapi = kichwa;
    N32 j = 0;
    wakati (j < UREFU) {
        N32 i = 0;
        wakati (i < UPANA) {
            // Antialiasing: wastani wa SAMPULI x SAMPULI miale ndani ya pikseli
            Vekta jumla = vekta_mpya(0.0, 0.0, 0.0);
            D64 sampuli_d = SAMPULI;
            N32 sj = 0;
            wakati (sj < SAMPULI) {
                N32 si = 0;
                wakati (si < SAMPULI) {
                    D64 id = i;
                    D64 jd = j;
                    D64 sid = si;
                    D64 sjd = sj;
                    D64 px = id + ((sid + 0.5) / sampuli_d);
                    D64 py = jd + ((sjd + 0.5) / sampuli_d);
                    D64 u = (((2.0 * px) / upana_d) - 1.0) * uwiano * kipimo;
                    D64 v = (1.0 - ((2.0 * py) / urefu_d)) * kipimo;
                    Vekta mwelekeo = vekta_sawazisha(vekta_mpya(u, v, 0.0 - 1.0));
                    Vekta c = fuatilia(mwale_mpya(jicho, mwelekeo));
                    jumla = vekta_jumlisha(jumla, c);
                    si = si + 1;
                }
                sj = sj + 1;
            }
            Vekta rangi = vekta_zidisha(jumla, 1.0 / (sampuli_d * sampuli_d));
            picha[wapi] = baiti_ya_rangi(rangi.x);
            picha[wapi + 1] = baiti_ya_rangi(rangi.y);
            picha[wapi + 2] = baiti_ya_rangi(rangi.z);
            wapi = wapi + 3;
            i = i + 1;
        }
        j = j + 1;
    }

    kama (faili_andika_yote("miale.ppm", picha, wapi) != 0) {
        andika("kosa: imeshindwa kuandika miale.ppm\n", 0, 0, 0, 0, 0, 0);
        rudisha 1;
    }
    andika("miale.ppm imeandikwa (%d x %d)\n", UPANA, UREFU, 0, 0, 0, 0);
    rudisha 0;
}
