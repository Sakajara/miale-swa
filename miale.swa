husisha { jiometri.swa }
husisha { kumbukumbu.swa }
husisha { mfuatano.swa }
husisha { faili.swa }

// miale.swa -- Kifuatilia-miale (raytracer) kwa Swa safi.
// Huchora duara tatu zenye rangi tofauti, zikiangazwa na taa moja
// (mwanga wa "diffuse"), na kuandika picha kwenye miale.ppm.

N32 UPANA = 400;
N32 UREFU = 300;
N32 IDADI_DUARA = 3;

Duara ulimwengu[3];
Vekta nuru;            // nafasi ya taa
N32 gonga_kielezo = 0; // kielezo cha duara lililogongwa na mwale_karibu()

W0 jenga_ulimwengu() {
    ulimwengu[0].kituo = vekta_mpya(0.0 - 1.2, 0.0, 0.0 - 4.0);
    ulimwengu[0].nusu_kipenyo = 1.0;
    ulimwengu[0].rangi = vekta_mpya(0.9, 0.2, 0.2);

    ulimwengu[1].kituo = vekta_mpya(1.3, 0.0 - 0.3, 0.0 - 3.2);
    ulimwengu[1].nusu_kipenyo = 0.7;
    ulimwengu[1].rangi = vekta_mpya(0.2, 0.8, 0.3);

    ulimwengu[2].kituo = vekta_mpya(0.1, 0.0 - 0.65, 0.0 - 2.2);
    ulimwengu[2].nusu_kipenyo = 0.35;
    ulimwengu[2].rangi = vekta_mpya(0.2, 0.4, 0.95);

    nuru = vekta_mpya(0.0 - 3.0, 5.0, 0.0 - 0.5);
}

// Rangi ya anga: mteremko kutoka nyeupe (chini) hadi buluu hafifu (juu)
Vekta anga(Mwale m) {
    D64 t = 0.5 * (m.mwelekeo.y + 1.0);
    Vekta nyeupe = vekta_mpya(1.0, 1.0, 1.0);
    Vekta buluu = vekta_mpya(0.5, 0.7, 1.0);
    rudisha vekta_jumlisha(vekta_zidisha(nyeupe, 1.0 - t), vekta_zidisha(buluu, t));
}

// Tafuta duara la karibu zaidi lililogongwa na mwale. Rudisha t (au -1.0),
// na weka kielezo chake kwenye gonga_kielezo.
D64 mwale_karibu(Mwale m) {
    D64 bora = 0.0 - 1.0;
    N32 i = 0;
    wakati (i < IDADI_DUARA) {
        Duara d = ulimwengu[i];
        D64 t = duara_gonga(d, m);
        kama (t > 0.0 && (bora < 0.0 || t < bora)) {
            bora = t;
            gonga_kielezo = i;
        }
        i = i + 1;
    }
    rudisha bora;
}

Vekta fuatilia(Mwale m) {
    D64 t = mwale_karibu(m);
    kama (t < 0.0) { rudisha anga(m); }

    Duara d = ulimwengu[gonga_kielezo];
    Vekta p = mwale_nukta(m, t);
    Vekta n = duara_kawaida(d, p);
    Vekta kuelekea_taa = vekta_sawazisha(vekta_toa(nuru, p));
    D64 mwanga = vekta_nukta(n, kuelekea_taa);
    kama (mwanga < 0.0) { mwanga = 0.0; }
    // mwanga wa mazingira 0.15 + diffuse 0.85
    rudisha vekta_zidisha(d.rangi, 0.15 + (0.85 * mwanga));
}

N32 baiti_ya_rangi(D64 c) {
    kama (c < 0.0) { c = 0.0; }
    kama (c > 1.0) { c = 1.0; }
    N32 b = c * 255.0;
    rudisha b;
}

N32 main() {
    jenga_ulimwengu();
    N64 uwezo = (UPANA * UREFU * 3) + 64;
    N8* picha = tenga(uwezo);
    N64 kichwa = mfuatano_umbiza(picha, 64, "P6\n%d %d\n255\n", UPANA, UREFU, 0, 0, 0, 0);

    Vekta jicho = vekta_mpya(0.0, 0.0, 1.0);
    D64 upana_d = UPANA;
    D64 urefu_d = UREFU;
    D64 uwiano = upana_d / urefu_d;
    D64 kipimo = 0.75;   // tan(nusu ya pembe ya kuona)

    N64 wapi = kichwa;
    N32 j = 0;
    wakati (j < UREFU) {
        N32 i = 0;
        wakati (i < UPANA) {
            D64 id = i;
            D64 jd = j;
            D64 u = (((2.0 * (id + 0.5)) / upana_d) - 1.0) * uwiano * kipimo;
            D64 v = (1.0 - ((2.0 * (jd + 0.5)) / urefu_d)) * kipimo;
            Vekta mwelekeo = vekta_sawazisha(vekta_mpya(u, v, 0.0 - 1.0));
            Vekta rangi = fuatilia(mwale_mpya(jicho, mwelekeo));
            picha[wapi] = baiti_ya_rangi(rangi.x);
            picha[wapi + 1] = baiti_ya_rangi(rangi.y);
            picha[wapi + 2] = baiti_ya_rangi(rangi.z);
            wapi = wapi + 3;
            i = i + 1;
        }
        j = j + 1;
    }

    kama (faili_andika_yote("miale.ppm", picha, wapi) != 0) {
        andika("kosa: imeshindwa kuandika miale.ppm\n", 0, 0, 0, 0, 0, 0);
        rudisha 1;
    }
    andika("miale.ppm imeandikwa (%d x %d)\n", UPANA, UREFU, 0, 0, 0, 0);
    rudisha 0;
}
